# Copy to tools/comfy/.env and fill in.
# Create key at https://platform.comfy.org (paid Cloud plan required for API).

COMFY_API_KEY=comfyui-xxxxxxxx

# Optional: leave unset to use Comfy Cloud (https://cloud.comfy.org).
# For local ComfyUI behind comfy-api-proxy:
# COMFY_BASE_URL=http://127.0.0.1:8189
